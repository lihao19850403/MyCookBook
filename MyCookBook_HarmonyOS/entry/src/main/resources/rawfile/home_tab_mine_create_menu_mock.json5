    },
    {
      "id": 1053,
      "type_id": 65,
      "type_name": "川菜",
      "cp_name": "家常海参",
      "zuofa": "海参片成上厚下薄的斧楞片，用好汤煨两次捞起。猪肉剁细。青蒜苗切成大粗花。黄豆芽去净根脚。豆瓣剁细。炒锅置火上，下猪油烧至四成热时下猪肉，放料酒、盐肥散，盛盘。再将锅洗净入下猪油烧至六成热时，下豆瓣炒出香味呈红色时，加入鲜汤烧沸，将豆瓣渣捞出，放入海参及肥好的猪肉、红酱油、料酒推转，将锅移至小火上煨，待煨至亮油时，勾薄芡，下蒜苗、味精、麻油推转。另用一锅烧猪油，将黄豆芽炒熟，装入盘中垫底，然后将海参连汁淋于豆芽上即成。",
      "texing": "汁色棕红，咸鲜微辣，海参粑糯，肉馅软酥。",
      "tishi": "",
      "tiaoliao": "",
      "yuanliao": "水发海参300克、猪肥瘦肉50克、黄豆芽100克、青蒜苗20克、郸县豆瓣20克、猪油65克、料酒20克、盐5克、鲜汤300克、红酱油10克、味精0.5克、麻油10克、豆粉10克。",
      "author": "助理",
      "createdTime": "2025-07-22 12:24:00"
    },
    {
      "id": 12000,
      "type_id": 72,
      "type_name": "闽菜",
      "cp_name": "家常烤鸡",
      "zuofa": "1.将鸡入沸水煮5分钟，捞出沥干；2.用昧精、盐、酒搽匀鸡身，腌半小时取出晾干，再用麦芽糖均匀地涂在鸡身上；3.鸡装入烤盘后进烤箱烘烤，胸向上25分钟，背向上15分钟取出淋上香油即可。",
      "texing": "",
      "tishi": "",
      "tiaoliao": "",
      "yuanliao": "鲜嫩鸡1只，味精3克，盐15克，酒l0克，花椒、葱、姜、麦芽糖少许。",
      "author": "助理",
